# =============================================================================
# KAMORA — Environment Configuration Template
# Copy this file to .env.local and fill in your real credentials.
# NEVER put real secrets in .env.example or commit .env.local.
# =============================================================================

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Kamora
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata

# --- Supabase (Required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Optional alias if using legacy anon JWT key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# SERVER ONLY — Never expose in client bundles
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key

# --- Active Payment Provider ("razorpay" | "stripe") ---
PAYMENT_PROVIDER=razorpay
NEXT_PUBLIC_PAYMENT_PROVIDER=razorpay

# --- Razorpay (Recommended for India: UPI, Cards, NetBanking, Wallets) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_ID=rzp_test_your_key_id
# SERVER ONLY
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- Optional: Stripe Payments ---
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
# STRIPE_SECRET_KEY=sk_test_your_secret_key
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# STRIPE_ENABLED_PAYMENT_METHODS=card

# --- Optional: Transactional Email (Resend) ---
# RESEND_API_KEY=
# EMAIL_FROM=Kamora Support <support@kamora.in>

# --- WhatsApp Support (91XXXXXXXXXX) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# --- Admin Bootstrap Secret (One-time /api/admin/bootstrap protection) ---
ADMIN_BOOTSTRAP_SECRET=replace-with-strong-random-32-char-secret
